{
  "name": "fluentremote-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:check": "npm run lint && npm run build",
    "start": "next start",
    "lint": "eslint",
    "extension:package": "node -e \"const {execSync}=require('child_process'),fs=require('fs');if(fs.existsSync('extension-package.zip'))fs.unlinkSync('extension-package.zip');execSync('cd extension && zip -r ../extension-package.zip . --exclude \\'*.DS_Store\\'',{stdio:\\'inherit\\'})\"",
    "extension:package:win": "powershell -NoProfile -Command \"if (Test-Path extension-package.zip) { Remove-Item extension-package.zip -Force }; Compress-Archive -Path extension\\* -DestinationPath extension-package.zip\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "tsx src/db/check.ts",
    "db:migrate-local-data": "tsx src/db/migrate-local-data.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
