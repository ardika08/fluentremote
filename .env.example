DATABASE_URL=postgresql://postgres:password@HOST:5432/postgres
DATABASE_SSL=auto

# Auth — generate with: openssl rand -base64 32
# REQUIRED: app will throw on startup if not set
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Encryption — generate with: openssl rand -base64 32
# REQUIRED: app will throw on startup if not set
# If not set, falls back to BETTER_AUTH_SECRET (not recommended for production)
FLUENTREMOTE_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Admin access
ADMIN_EMAILS=admin@example.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Mayar Payment
MAYAR_API_KEY=your-mayar-api-key
# MAYAR_WEBHOOK_SECRET: Used for HMAC-SHA256 webhook verification.
# Set this to the webhook secret from your Mayar dashboard (Webhook → Secret).
# Falls back to MAYAR_WEBHOOK_TOKEN for backward-compatibility.
MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret
MAYAR_WEBHOOK_TOKEN=your-mayar-webhook-token
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
MAYAR_PRICE_AMOUNT=99000
MAYAR_CURRENCY=IDR
MAYAR_PRODUCT_DESCRIPTION=FluentRemote lifetime access

# AI Providers
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
MAIA_ROUTER_API_KEY=your-maia-router-api-key
MAIA_ROUTER_BASE_URL=https://api.maiarouter.ai/v1
MAIA_ROUTER_MODEL=maia/gemini-2.5-flash

# Chrome Extension
# REQUIRED in production: set to your extension's Chrome ID to restrict CORS.
# Example: EXTENSION_CHROME_ID=abcdefghijklmnopqrstuvwxyz012345
# In development (NODE_ENV != production) this is optional.
EXTENSION_CHROME_ID=
